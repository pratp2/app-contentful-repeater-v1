  },
  "devDependencies": {
    "@contentful/app-scripts": "^2.5.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.2"
  }
}
