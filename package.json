{
  "name": "app-contentful-repeater-v1",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@contentful/app-sdk": "4.45.0",
    "@contentful/f36-components": "^5.6.0",
    "@contentful/f36-icons": "^5.6.0",
    "@contentful/f36-tokens": "5.1.0",
    "@contentful/forma-36-tokens": "^0.11.2",
    "@contentful/react-apps-toolkit": "1.2.16",
    "@emotion/css": "^11.13.5",
    "contentful-management": "11.61.0",
    "emotion": "11.0.0",
    "happy-dom": "^20.0.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "uuid": "^13.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
