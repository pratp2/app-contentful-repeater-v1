{
  "name": "app-contentful-repeater",
  "version": "0.1.0",
  "description": "A Contentful App for repeating and managing structured content efficiently.",
  "author": "Prem Pratick Kumar",
  "license": "UNLICENSED",
  "private": true,

  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },

  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",

    "contentful:create": "contentful-app-scripts create-app-definition",
    "contentful:add-locations": "contentful-app-scripts add-locations",
    "contentful:upload": "contentful-app-scripts upload --bundle-dir ./dist",
    "contentful:upload:ci": "contentful-app-scripts upload --ci --bundle-dir ./dist --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN"
  },

  "dependencies": {
    "@contentful/app-sdk": "4.51.4",
    "@contentful/f36-components": "^5.9.0",
    "@contentful/f36-icons": "^5.9.0",
    "@contentful/f36-tokens": "5.1.0",
    "@contentful/forma-36-tokens": "^0.11.2",
    "@contentful/react-apps-toolkit": "1.2.19",
    "@emotion/css": "^11.13.5",
    "contentful-management": "11.68.1",
    "happy-dom": "^20.4.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^13.0.0"
  },

  "devDependencies": {
    "@contentful/app-scripts": "^2.5.8",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.1.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.5.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
